# Server Configuration
NODE_ENV=development
CORE_SECRET=core_secret
PORT=4000
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=postgres_db
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public"
JWT_SECRET=jwt_secret
JWT_EXPIRES_IN=15m
JWT_ISSUER=project-vtx

# Auth Rate Limiting (TASK 02)
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=5

# CORS Configuration (TASK 03)
# Whitelist separada por vírgula de origens autorizadas a consumir a API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Habilitar envio de credenciais (cookies/tokens em headers de autorização restritos)
CORS_CREDENTIALS=false
